# Secret key used for session signing and general security
SECRET_KEY=your-secret-key-change-me

# Key used specifically to sign JWT access tokens
JWT_SECRET_KEY=your-jwt-secret-key-change-me

# JWT access token lifetime in seconds (default 24 hours)
JWT_ACCESS_TOKEN_EXPIRES=86400

# MySQL database connection settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=plant_disease_db

# Optional full override of the SQLAlchemy database URI.
# If set, it takes precedence over the individual DB_* settings above.
# Example: mysql://user:pass@localhost:3306/plant_disease_db?charset=utf8mb4
DATABASE_URL=

# Uploaded image configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,bmp,webp

# Machine learning model paths
ML_MODEL_PATH=ml_model/plant_disease_model.h5
LABEL_MAP_PATH=ml_model/label_map.json

# Comma separated list of allowed frontend origins for CORS.
# Example: http://localhost:3000,https://myapp.com
FRONTEND_ORIGIN=http://localhost:3000
